{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile, puzzle rating, streaks, solved counts, level progress, and session statistics in one document.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID matching the document ID." },
        "displayName": { "type": "string", "description": "Display name shown on Home and PGN headers." },
        "email": { "type": "string", "description": "Authenticated account email address." },
        "avatarUrl": { "type": "string", "description": "Optional HTTPS URL for user avatar." },
        "preferredDifficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
        "rating": { "type": "number", "description": "Current tactical puzzle ELO rating." },
        "ratedCount": { "type": "integer", "description": "Total rated puzzles attempted." },
        "streak": { "type": "integer", "description": "Current consecutive puzzle streak." },
        "bestStreak": { "type": "integer", "description": "All-time highest consecutive puzzle streak." },
        "winStreak": { "type": "integer", "description": "Bot match win streak." },
        "puzzlesSolved": { "type": "integer", "description": "Total puzzles solved." },
        "dailyGoal": { "type": "integer", "description": "Daily puzzle challenge target." },
        "dailySolvedToday": { "type": "integer", "description": "Puzzles solved on dailySolvedDate." },
        "dailySolvedDate": { "type": "string", "description": "YYYY-MM-DD local date for daily challenge tracking." },
        "levelProgress": { "type": "object", "description": "Map of puzzle level index (0..6) to solved puzzle count." },
        "gamesPlayedBot": { "type": "integer" },
        "gamesAnalysed": { "type": "integer" },
        "ratingHistory": { "type": "array", "description": "Recent rating checkpoints [{t, r}]." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp set via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp set via FieldValue.serverTimestamp()." }
      },
      "required": [
        "userId", "displayName", "preferredDifficulty",
        "rating", "ratedCount", "streak", "bestStreak", "winStreak",
        "puzzlesSolved", "dailyGoal", "dailySolvedToday", "dailySolvedDate",
        "levelProgress", "gamesPlayedBot", "gamesAnalysed", "ratingHistory",
        "createdAt", "updatedAt"
      ]
    },
    "CloudSavedGame": {
      "title": "CloudSavedGame",
      "description": "Finished or analysed chess game record saved once a game ends.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "opponent": { "type": "string" },
        "result": { "type": "string", "enum": ["1-0", "0-1", "1/2-1/2", "*"] },
        "source": { "type": "string", "enum": ["bot", "friend", "analysed"] },
        "timestampMs": { "type": "integer" },
        "plies": { "type": "integer" },
        "moves": { "type": "integer" },
        "pgn": { "type": "string" },
        "evals": { "type": "array" },
        "bestMoves": { "type": "array" },
        "whiteCounts": { "type": "array" },
        "blackCounts": { "type": "array" },
        "whitePhaseMistakes": { "type": "array" },
        "blackPhaseMistakes": { "type": "array" },
        "mistakes": { "type": "array" },
        "whiteAccuracy": { "type": "number", "description": "White overall move accuracy percentage (0-100)." },
        "blackAccuracy": { "type": "number", "description": "Black overall move accuracy percentage (0-100)." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp set via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp set via FieldValue.serverTimestamp()." }
      },
      "required": [
        "userId", "title", "opponent", "result", "source",
        "timestampMs", "plies", "moves", "pgn",
        "evals", "bestMoves", "whiteCounts", "blackCounts",
        "whitePhaseMistakes", "blackPhaseMistakes", "mistakes",
        "createdAt", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-only single document for rating, streak, level progress, and profile statistics."
    },
    "/users/{userId}/games/{gameId}": {
      "schema": { "$ref": "#/entities/CloudSavedGame" },
      "description": "Owner-only finished and analysed chess games subcollection."
    }
  }
}
