rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 60 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 160)) &&
             (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 800)) &&
             data.preferredDifficulty is string &&
             data.preferredDifficulty.size() <= 20 &&
             data.preferredDifficulty in ['easy', 'medium', 'hard'] &&
             data.rating is number &&
             data.rating >= 0 &&
             data.rating <= 4000 &&
             data.ratedCount is int &&
             data.ratedCount >= 0 &&
             data.ratedCount <= 1000000 &&
             data.streak is int &&
             data.streak >= 0 &&
             data.streak <= 1000000 &&
             data.bestStreak is int &&
             data.bestStreak >= 0 &&
             data.bestStreak <= 1000000 &&
             data.winStreak is int &&
             data.winStreak >= 0 &&
             data.winStreak <= 1000000 &&
             data.puzzlesSolved is int &&
             data.puzzlesSolved >= 0 &&
             data.puzzlesSolved <= 1000000 &&
             data.dailyGoal is int &&
             data.dailyGoal >= 1 &&
             data.dailyGoal <= 100 &&
             data.dailySolvedToday is int &&
             data.dailySolvedToday >= 0 &&
             data.dailySolvedToday <= 10000 &&
             data.dailySolvedDate is string &&
             data.dailySolvedDate.size() <= 16 &&
             data.levelProgress is map &&
             data.levelProgress.size() <= 10 &&
             data.gamesPlayedBot is int &&
             data.gamesPlayedBot >= 0 &&
             data.gamesPlayedBot <= 1000000 &&
             data.gamesAnalysed is int &&
             data.gamesAnalysed >= 0 &&
             data.gamesAnalysed <= 1000000 &&
             data.ratingHistory is list &&
             data.ratingHistory.size() <= 100 &&
             (data.ratingHistory.size() == 0 || data.ratingHistory[0] is map) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidSavedGame(data) {
      return data.userId is string &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 160 &&
             data.opponent is string &&
             data.opponent.size() <= 100 &&
             data.result is string &&
             data.result.size() <= 12 &&
             data.result in ['1-0', '0-1', '1/2-1/2', '*'] &&
             data.source is string &&
             data.source.size() <= 16 &&
             data.source in ['bot', 'friend', 'analysed'] &&
             data.timestampMs is int &&
             data.timestampMs >= 0 &&
             data.plies is int &&
             data.plies >= 0 &&
             data.plies <= 1000 &&
             data.moves is int &&
             data.moves >= 0 &&
             data.moves <= 500 &&
             data.pgn is string &&
             data.pgn.size() >= 1 &&
             data.pgn.size() <= 30000 &&
             data.evals is list &&
             data.evals.size() <= 500 &&
             (data.evals.size() == 0 || data.evals[0] is number) &&
             data.bestMoves is list &&
             data.bestMoves.size() <= 500 &&
             (data.bestMoves.size() == 0 || data.bestMoves[0] is string) &&
             data.whiteCounts is list &&
             data.whiteCounts.size() <= 10 &&
             (data.whiteCounts.size() == 0 || data.whiteCounts[0] is int) &&
             data.blackCounts is list &&
             data.blackCounts.size() <= 10 &&
             (data.blackCounts.size() == 0 || data.blackCounts[0] is int) &&
             data.whitePhaseMistakes is list &&
             data.whitePhaseMistakes.size() <= 5 &&
             (data.whitePhaseMistakes.size() == 0 || data.whitePhaseMistakes[0] is int) &&
             data.blackPhaseMistakes is list &&
             data.blackPhaseMistakes.size() <= 5 &&
             (data.blackPhaseMistakes.size() == 0 || data.blackPhaseMistakes[0] is int) &&
             data.mistakes is list &&
             data.mistakes.size() <= 10 &&
             (data.mistakes.size() == 0 || data.mistakes[0] is map) &&
             (!('whiteAccuracy' in data) || (data.whiteAccuracy is number && data.whiteAccuracy >= 0 && data.whiteAccuracy <= 100)) &&
             (!('blackAccuracy' in data) || (data.blackAccuracy is number && data.blackAccuracy >= 0 && data.blackAccuracy <= 100)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'preferredDifficulty',
                         'rating', 'ratedCount', 'streak', 'bestStreak', 'winStreak',
                         'puzzlesSolved', 'dailyGoal', 'dailySolvedToday', 'dailySolvedDate',
                         'levelProgress', 'gamesPlayedBot', 'gamesAnalysed', 'ratingHistory',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'email', 'avatarUrl', 'preferredDifficulty',
                         'rating', 'ratedCount', 'streak', 'bestStreak', 'winStreak',
                         'puzzlesSolved', 'dailyGoal', 'dailySolvedToday', 'dailySolvedDate',
                         'levelProgress', 'gamesPlayedBot', 'gamesAnalysed', 'ratingHistory',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());
      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'email', 'avatarUrl', 'preferredDifficulty',
                         'rating', 'ratedCount', 'streak', 'bestStreak', 'winStreak',
                         'puzzlesSolved', 'dailyGoal', 'dailySolvedToday', 'dailySolvedDate',
                         'levelProgress', 'gamesPlayedBot', 'gamesAnalysed', 'ratingHistory',
                         'updatedAt'
                       ]);
      allow delete: if isOwner(userId) && isValidId(userId);

      match /games/{gameId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(gameId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(gameId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'opponent', 'result', 'source',
                           'timestampMs', 'plies', 'moves', 'pgn',
                           'evals', 'bestMoves', 'whiteCounts', 'blackCounts',
                           'whitePhaseMistakes', 'blackPhaseMistakes', 'mistakes',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'opponent', 'result', 'source',
                           'timestampMs', 'plies', 'moves', 'pgn',
                           'evals', 'bestMoves', 'whiteCounts', 'blackCounts',
                           'whitePhaseMistakes', 'blackPhaseMistakes', 'mistakes',
                           'whiteAccuracy', 'blackAccuracy',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidSavedGame(incoming());
        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(gameId) &&
                         isValidSavedGame(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'opponent', 'result', 'source',
                           'timestampMs', 'plies', 'moves', 'pgn',
                           'evals', 'bestMoves', 'whiteCounts', 'blackCounts',
                           'whitePhaseMistakes', 'blackPhaseMistakes', 'mistakes',
                           'whiteAccuracy', 'blackAccuracy',
                           'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(gameId);
      }
    }
  }
}
