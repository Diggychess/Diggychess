rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 60 &&
             (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 800)) &&
             data.preferredDifficulty is string &&
             data.preferredDifficulty.size() <= 20 &&
             data.preferredDifficulty in ['easy', 'medium', 'hard'] &&
             data.gamesPlayedBot is int &&
             data.gamesPlayedBot >= 0 &&
             data.gamesPlayedBot <= 1000000 &&
             data.gamesAnalysed is int &&
             data.gamesAnalysed >= 0 &&
             data.gamesAnalysed <= 1000000 &&
             data.puzzlesSolved is int &&
             data.puzzlesSolved >= 0 &&
             data.puzzlesSolved <= 1000000 &&
             data.winStreak is int &&
             data.winStreak >= 0 &&
             data.winStreak <= 1000000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidSavedGame(data) {
      return data.userId is string &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 160 &&
             data.timestampMs is int &&
             data.timestampMs >= 0 &&
             data.plies is int &&
             data.plies >= 0 &&
             data.plies <= 1000 &&
             data.moves is int &&
             data.moves >= 0 &&
             data.moves <= 500 &&
             data.pgn is string &&
             data.pgn.size() >= 1 &&
             data.pgn.size() <= 30000 &&
             data.evals is list &&
             data.evals.size() <= 500 &&
             (data.evals.size() == 0 || data.evals[0] is number) &&
             data.bestMoves is list &&
             data.bestMoves.size() <= 500 &&
             (data.bestMoves.size() == 0 || data.bestMoves[0] is string) &&
             data.whiteCounts is list &&
             data.whiteCounts.size() <= 10 &&
             (data.whiteCounts.size() == 0 || data.whiteCounts[0] is int) &&
             data.blackCounts is list &&
             data.blackCounts.size() <= 10 &&
             (data.blackCounts.size() == 0 || data.blackCounts[0] is int) &&
             data.whitePhaseMistakes is list &&
             data.whitePhaseMistakes.size() <= 5 &&
             (data.whitePhaseMistakes.size() == 0 || data.whitePhaseMistakes[0] is int) &&
             data.blackPhaseMistakes is list &&
             data.blackPhaseMistakes.size() <= 5 &&
             (data.blackPhaseMistakes.size() == 0 || data.blackPhaseMistakes[0] is int) &&
             data.mistakes is list &&
             data.mistakes.size() <= 10 &&
             (data.mistakes.size() == 0 || data.mistakes[0] is map) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidPuzzleProgress(data) {
      return data.userId is string &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.rating is number &&
             data.rating >= 0 &&
             data.rating <= 4000 &&
             data.ratedCount is int &&
             data.ratedCount >= 0 &&
             data.ratedCount <= 1000000 &&
             data.dailyGoal is int &&
             data.dailyGoal >= 1 &&
             data.dailyGoal <= 100 &&
             data.ratingHistory is list &&
             data.ratingHistory.size() <= 100 &&
             (data.ratingHistory.size() == 0 || data.ratingHistory[0] is map) &&
             data.seenIds is list &&
             data.seenIds.size() <= 400 &&
             (data.seenIds.size() == 0 || data.seenIds[0] is string) &&
             data.recentAttempts is list &&
             data.recentAttempts.size() <= 300 &&
             (data.recentAttempts.size() == 0 || data.recentAttempts[0] is map) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'preferredDifficulty',
                         'gamesPlayedBot', 'gamesAnalysed', 'puzzlesSolved',
                         'winStreak', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'avatarUrl', 'preferredDifficulty',
                         'gamesPlayedBot', 'gamesAnalysed', 'puzzlesSolved',
                         'winStreak', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());
      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'avatarUrl', 'preferredDifficulty',
                         'gamesPlayedBot', 'gamesAnalysed', 'puzzlesSolved',
                         'winStreak', 'updatedAt'
                       ]);
      allow delete: if isOwner(userId) && isValidId(userId);

      match /games/{gameId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(gameId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(gameId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'timestampMs', 'plies', 'moves', 'pgn',
                           'evals', 'bestMoves', 'whiteCounts', 'blackCounts',
                           'whitePhaseMistakes', 'blackPhaseMistakes', 'mistakes',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'timestampMs', 'plies', 'moves', 'pgn',
                           'evals', 'bestMoves', 'whiteCounts', 'blackCounts',
                           'whitePhaseMistakes', 'blackPhaseMistakes', 'mistakes',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidSavedGame(incoming());
        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(gameId) &&
                         isValidSavedGame(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'timestampMs', 'plies', 'moves', 'pgn',
                           'evals', 'bestMoves', 'whiteCounts', 'blackCounts',
                           'whitePhaseMistakes', 'blackPhaseMistakes', 'mistakes',
                           'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(gameId);
      }

      match /progress/{progressId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(progressId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(progressId) &&
                         incoming().keys().hasAll([
                           'userId', 'rating', 'ratedCount', 'dailyGoal',
                           'ratingHistory', 'seenIds', 'recentAttempts',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'rating', 'ratedCount', 'dailyGoal',
                           'ratingHistory', 'seenIds', 'recentAttempts',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidPuzzleProgress(incoming());
        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(progressId) &&
                         isValidPuzzleProgress(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'rating', 'ratedCount', 'dailyGoal',
                           'ratingHistory', 'seenIds', 'recentAttempts',
                           'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(progressId);
      }
    }
  }
}
